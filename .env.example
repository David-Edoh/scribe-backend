# PostgreSQL connection (example)
DATABASE_URL=postgres://user:password@localhost:5432/scribe

# JWT secret
JWT_SECRET=super-secret

PORT=3000

# PostgreSQL SSL/TLS Certificate (base64 encoded)
# When using a managed database with custom CA (e.g., Aiven, AWS RDS with custom CA)
# Encode the CA certificate in base64: cat ca.crt | base64 | tr -d '\n'
# The cert is decoded at runtime and NOT written to disk for security
# PG_CA_BASE64=your-base64-encoded-ca-cert-here

# Email service (Resend)
RESEND_API_KEY=your-resend-api-key
SENDER_EMAIL=noreply@example.com

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:5173

# Embedding Generation Strategy
# Set to true to use locally hosted all-minilm-l6-v2 model
# Set to false (or omit) to use Gemini API embeddings
# Local embeddings are useful when you hit Gemini quota limits
USE_LOCAL_EMBEDDING=false

