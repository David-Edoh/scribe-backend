generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  profiles  VoiceProfile[]
}

model VoiceProfile {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  name             String
  biography        String?
  signaturePhrases String[] @default([])
  anchorScriptures String[] @default([])
  styleAttributes  Json?
  personalStories  Json?
  sampleTexts      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  embeddings       VoiceProfileEmbedding[]
}

model VoiceProfileEmbedding {
  id             String   @id @default(uuid())
  voiceProfileId String
  voiceProfile   VoiceProfile @relation(fields: [voiceProfileId], references: [id], onDelete: Cascade)
  embedding      Float[]
  metadata       Json?
  createdAt      DateTime @default(now())
}

model Manuscript {
  id        String   @id @default(uuid())
  userId    String
  title     String
  outline   Json?
  content   String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
